{"type": "result", "id": "R005_main_e0_t004", "ttft_ms": 6958, "total_ms": 22254, "tokens": 684, "prompt_tokens": 23733, "cached_tokens": 22496, "native_ttft_ms": 6913.1, "native_prefill_tps": 178.94, "native_decode_tps": 44.65, "content": "", "tool_calls": [{"id": "call_ef0380e908df79c5363c09e2b4986d79_0", "type": "function", "function": {"name": "bash", "arguments": "{\"command\":\"./.venv/bin/python3 - <<'EOF'\\nimport json, collections\\nrecs=[json.loads(l) for l in open('Resources/features/f-428/runs/P12.7/base-debug.jsonl')]\\nprint(\\\"n=\\\",len(recs))\\nkeys=collections.Counter()\\natomkeys=collections.Counter()\\nfor r in recs:\\n    keys.update(r.keys())\\n    for a in r.get('atoms',[]):\\n        atomkeys.update(a.keys())\\nprint(\\\"rec:\\\",dict(keys))\\nprint(\\\"atom:\\\",dict(atomkeys))\\npaths=collections.Counter(a.get('path') for r in recs for a in r.get('atoms',[]))\\nprint(\\\"paths:\\\",dict(paths))\\n# auto-wrong lines\\naw=[r for r in recs if r.get('auto') and not r.get('correct')]\\nprint(\\\"auto-wrong:\\\",len(aw))\\n# check fields present on auto-wrong lines\\nmissing=collections.Counter()\\nfor r in aw:\\n    for f in ['rawText','expectedDescriptions','expectedDataTypes','actualDescriptions','actualDataTypes']:\\n        if f not in r or r[f] is None: missing[f]+=1\\n    for a in r.get('atoms',[]):\\n        for f in ['path','reused','linkedIngredientId','parsedName','candidates']:\\n            if f not in a: missing['atom.'+f]+=1\\nprint(\\\"missing on auto-wrong:\\\",dict(missing))\\n# sets\\nprint(\\\"sets:\\\",collections.Counter(r.get('set') for r in recs))\\n# example auto-wrong with atoms\\nfor r in aw[:3]:\\n    print(r['rawText'][:60],'| exp:',r['expectedDescriptions'][:1],'| act:',r['actualDescriptions'][:1],'| atoms:',[(a.get('path'),a.get('reused'),a.get('parsedName')) for a in r.get('atoms',[])])\\nEOF\",\"i\":\"Inspecting trace field coverage on auto-wrong lines\"}"}}], "finish_reason": "tool_calls", "reasoning_tokens": 218, "reasoning_chars": 964, "prompt_progress": {"total": 23733, "cache": 22496, "processed": 23733, "time_ms": 6913}, "usage": {"prompt_tokens": 23733, "completion_tokens": 684, "total_tokens": 24417, "prompt_tokens_details": {"cached_tokens": 22496}, "completion_tokens_details": {"reasoning_tokens": 218}}, "timings": {"prompt_n": 23733, "prompt_ms": 6913.103, "prompt_per_second": 178.93556627175957, "predicted_n": 684, "predicted_ms": 15295.775, "predicted_per_second": 44.65285348405033, "cache_n": 22496, "draft_n": 1176, "draft_n_accepted": 515}, "metrics": {"prefill": {"tokens": 1237}, "decode": {"tokens": 683}, "request_latency": {"start_to_first_token_ms": 6913.103, "first_token_to_done_ms": 15295.775, "wall_ms": 22242.191, "ttft_ms": 6946.415999999999, "queue_to_start_ms": 33.31299999999919, "stream_tokens_per_second": 44.65285348405033}, "cache": {"status": "hit", "matched_tokens": 22496, "deduplicated_tokens": 32, "lane": 0}, "speculation": {"drafted_tokens": 1176, "accepted_draft_tokens": 515, "cycles": 168}}, "stream": "main", "kind": "turn", "epoch": 0, "turn": 4, "recorded_prompt_tokens": 23729, "recorded_tools": ["bash", "bash"], "tool_names": ["bash"], "matches_recorded": false, "in_line": true, "eval_result": "PASS", "fail_reason": "other tools: bash (recorded bash,bash)"}
